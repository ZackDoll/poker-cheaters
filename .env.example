# Copy to .env.local for local dev (vercel dev), and set the same names in
# Vercel -> Project Settings -> Environment Variables. Never commit real values.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string (Neon or Supabase)
DATABASE_URL=

# Public origin of the site, no trailing slash.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
APP_URL=http://localhost:3000
