# Copy to backend/.env to override the defaults in app/config.py.
DATABASE_URL=postgresql+psycopg://poker:poker@localhost:5432/poker
MAX_UPLOAD_BYTES=52428800
SIGNAL_TIMEOUT_SECONDS=15
BLUFF_PRIOR=0.35
FUSION_WEIGHTS={"statistics": 1.0, "facial": 0.5, "speech": 0.5, "live_facial": 0.5}

# Live rooms. Must match ROOM_TOKEN_SECRET in the root .env.local.
ROOM_TOKEN_SECRET=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
